{
  "expo": {
    "name": "FirstSign",
    "slug": "firstsign",
    "version": "1.0.0",
    "description": "FirstSign détecte les signes avant-coureurs du burnout professionnel avant qu'il ne soit trop tard. Évaluation scientifique CBI, suivi hebdomadaire et accompagnement personnalisé.",
    "scheme": "firstsign",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.burnoutapp"
    },
    "android": {
      "package": "com.burnoutapp",
      "adaptiveIcon": {
        "backgroundColor": "#1D9E75",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#1D9E75",
          "sounds": []
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#1D9E75"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "c044aedf-1ee6-4b4d-9867-3b1d2557f371"
      },
      "router": {}
    },
    "owner": "nicolaspoda"
  }
}
